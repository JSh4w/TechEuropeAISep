# Copy to .env (scripts/setup.sh does this) and fill in. Never commit .env.
# Get the values from Josh over a private channel.

# --- Gemini (Google DeepMind) — reasoning calls ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Pydantic AI Gateway — routes calls to our Modal endpoint (and other providers) ---
# Logfire → Gateway → API keys. Use the gateway ROOT url; the route name is added in code.
PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy

# --- Modal endpoint behind the gateway ---
# Gateway provider name (Logfire → Gateway → Providers) and the Hugging Face model ID
# deployed with `modal endpoint create --name gateway --model <MODEL>`.
MODAL_GATEWAY_ROUTE=modal
MODAL_MODEL=google/gemma-4-31B-it
# Proxy token from `modal workspace proxy-tokens create`. Not used by the code — the gateway
# holds it — but the secret is only shown once, so keep a copy here.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# --- Logfire tracing (project settings → Write tokens) ---
LOGFIRE_TOKEN=

# --- Jev classification (optional) ---
TYPESAFE_API_KEY=

# --- Temporal (local dev server) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- External Network & Map Open Data APIs (optional / free keys) ---
# UK Power Networks open data portal (free key: ukpowernetworks.opendatasoft.com -> account -> API keys)
UKPN_API_KEY=
# SSEN Transmission open data portal (north of Scotland; free key: ssentransmission.opendatasoft.com -> account -> API keys)
SSEN_API_KEY=
# National Grid Electricity Distribution (South West, Wales, Midlands; free token: connecteddata.nationalgrid.co.uk -> account -> API tokens)
NGED_API_KEY=
# Ordnance Survey Data Hub (optional; free key: osdatahub.os.uk -> API Dashboard -> APIs; replaces OpenTopoMap in site_report.py)
OS_API_KEY=
