# Bessible Deployment Environment Configuration
# Copy this file to .env on the deployment server: cp .env.example .env

# Container image owner for GHCR
IMAGE_OWNER=skreslett

# Master encryption secret for user Google keys stored in SQLite
# Generate one using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEY_ENCRYPTION_SECRET=

# Firebase Auth configuration (Spark plan / Google sign-in)
FIREBASE_PROJECT_ID=
# Optional: comma-separated list of allowed user emails (empty allows any authenticated user)
ALLOWED_EMAILS=

# Classifier backend: auto | modal | llm | heuristic
CLASSIFIER_BACKEND=auto

# Optional Server-level API keys (users can also provide their own Google Gemini key via UI)
GOOGLE_API_KEY=
OS_API_KEY=
SSEN_API_KEY=
UKPN_API_KEY=
NGED_API_KEY=
LOGFIRE_TOKEN=

# Frontend build-time Firebase configuration (if building the web image locally)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
