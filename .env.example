# Bessible — environment configuration template
# Copy to .env and fill in the keys you have: cp .env.example .env
#
# Only the models you actually invoke need keys:
#   - Gemini reasoning calls: GOOGLE_API_KEY (Google AI Studio)
#   - Open-weight models on Modal via Pydantic AI Gateway: PYDANTIC_AI_GATEWAY_API_KEY + MODAL_TOKEN_ID + MODAL_TOKEN_SECRET
#   - Typed classification: TYPESAFE_API_KEY (Jev)
#   - Tracing (optional): LOGFIRE_TOKEN
#
# Temporal runs locally: temporal server start-dev
# Pydantic AI Gateway: gateway-eu.pydantic.dev

# --- LLM Providers ---
# Google DeepMind / AI Studio (for Gemini 2.5 Flash reasoning calls)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Pydantic AI Gateway (proxies our self-hosted models on Modal)
PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
MODAL_GATEWAY_ROUTE=modal
MODAL_MODEL=google/gemma-4-31B-it

# Logfire (agent and activity tracing; optional)
LOGFIRE_TOKEN=

# TypeSafe / Jev (typed classification; optional)
TYPESAFE_API_KEY=

# --- Temporal (local dev server) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- External Network & Map Open Data APIs (optional / free keys) ---
# UK Power Networks open data portal (free key: ukpowernetworks.opendatasoft.com -> account -> API keys)
UKPN_API_KEY=
# SSEN Transmission open data portal (north of Scotland; free key: ssentransmission.opendatasoft.com -> account -> API keys)
SSEN_API_KEY=
# National Grid Electricity Distribution connected data portal (Midlands, South West, South Wales)
NGED_API_KEY=
